<Window x:Class="FileGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Test File Generator"
        Width="620"
        Height="270"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition />
            <ColumnDefinition Width="201" />
        </Grid.ColumnDefinitions>

        <TextBlock VerticalAlignment="Center" Text="Output file:" Height="16" />
        <TextBox x:Name="OutputPathTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,8,12" Grid.RowSpan="2" />
        <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Click="BrowseButton_Click" />

        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Minimum size, MB:" Height="16" />
        <TextBox x:Name="SizeInMegabytesTextBox"
                 Grid.Row="2"
                 Grid.Column="1"
                 HorizontalAlignment="Left"
                 Width="140"
                 Text="100" Margin="0,0,0,12" Grid.RowSpan="2" />

        <ProgressBar x:Name="GenerationProgressBar"
                     Grid.Row="4"
                     Grid.ColumnSpan="3"
                     IsIndeterminate="False" Margin="0,0,0,12" />

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="6"
                   VerticalAlignment="Center"
                   Text="Ready" Height="16" Grid.ColumnSpan="2" Margin="10,0,0,0" />

        <Grid Grid.Row="6" Grid.Column="2" Margin="0,0,0,-2" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Button x:Name="GenerateButton"
                    Content="Generate"
                    Click="GenerateButton_Click" Margin="0,0,20,0" />
            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Width="64"
                    HorizontalAlignment="Right"
                    Content="Cancel"
                    IsEnabled="False"
                    Click="CancelButton_Click" />
        </Grid>
    </Grid>
</Window>
