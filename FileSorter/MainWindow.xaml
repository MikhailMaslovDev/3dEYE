<Window x:Class="FileSorter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Large File Sorter"
        Width="740"
        Height="365"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition />
            <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>

        <TextBlock VerticalAlignment="Center" Text="Input file:" />
        <TextBox x:Name="InputPathTextBox" Grid.Column="1" Margin="0,0,8,0" />
        <Button Grid.Column="2"
                Width="90"
                HorizontalAlignment="Left"
                Content="Browse..."
                Click="BrowseInputButton_Click" />

        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Output file:" />
        <TextBox x:Name="OutputPathTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,8,0" />
        <Button Grid.Row="2"
                Grid.Column="2"
                Width="90"
                HorizontalAlignment="Left"
                Content="Browse..."
                Click="BrowseOutputButton_Click" />

        <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Memory per worker, MB:" />
        <TextBox x:Name="MemoryPerWorkerTextBox"
                 Grid.Row="4"
                 Grid.Column="1"
                 Width="140"
                 HorizontalAlignment="Left"
                 Text="256" />

        <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="Sorting workers:" />
        <TextBox x:Name="WorkerCountTextBox"
                 Grid.Row="6"
                 Grid.Column="1"
                 Width="140"
                 HorizontalAlignment="Left"
                 Text="2" />

        <ProgressBar x:Name="SortingProgressBar"
                     Grid.Row="8"
                     Grid.ColumnSpan="3"
                     Height="20" />

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="10"
                   Grid.ColumnSpan="2"
                   VerticalAlignment="Center"
                   Text="Ready" />

        <Grid Grid.Row="10" Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Button x:Name="SortButton"
                    Width="80"
                    HorizontalAlignment="Left"
                    Content="Sort"
                    Click="SortButton_Click" />
            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Width="64"
                    HorizontalAlignment="Right"
                    Content="Cancel"
                    IsEnabled="False"
                    Click="CancelButton_Click" />
        </Grid>
    </Grid>
</Window>
